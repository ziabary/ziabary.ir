{
  "name": "ziabary-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "svelte-kit sync && vite dev",
    "build": "vite build",
    "build:verify-stable": "bash scripts/verify-stable-assets.sh",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "deploy:s3": "npm run build && node scripts/deploy-object-storage.mjs",
