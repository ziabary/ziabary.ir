  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@sveltejs/adapter-static": "^3.0.9",
    "@sveltejs/kit": "^2.37.0",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "mdsvex": "^0.12.6",
    "svelte": "^5.38.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
