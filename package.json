{
  "name": "ziabary-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run prepare:content && svelte-kit sync && vite dev",
    "build": "npm run prepare:content && vite build && node scripts/generate-sitemap.mjs && npm run verify:sitemap && node scripts/verify-structured-data.mjs && npm run verify:short-links",
    "verify:sitemap": "node scripts/verify-sitemap.mjs",
    "test:sitemap": "node --test tests/sitemap.test.mjs",
    "test:seo": "node --test tests/page-seo.test.mjs",
    "build:verify-stable": "bash scripts/verify-stable-assets.sh",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "deploy": "npm run build && node scripts/deploy-object-storage.mjs",
    "prepare": "svelte-kit sync",
    "prepare:content": "npm run prepare:assets && npm run prepare:icons && node scripts/generate-search-index.mjs && npm run prepare:short-links",
    "prepare:icons": "node scripts/prepare-icons.mjs",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "preview:local": "node scripts/serve-local.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify:local": "python3 scripts/verify-local-build.py",
    "prepare:short-links": "node scripts/generate-short-links.mjs",
    "verify:short-links": "node scripts/verify-short-links.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@sveltejs/adapter-static": "^3.0.9",
    "@sveltejs/kit": "^2.37.0",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "katex": "^0.16.47",
    "mdsvex": "^0.12.6",
    "remark-math": "^3.0.1",
    "svelte": "^5.38.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
