# ArvanCloud Object Storage example for ziabary.ir.
# Copy this file to .env.deploy and fill in the real access keys.
# .env.deploy is ignored by Git and must never be committed.
S3_BUCKET=ziabary
S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
S3_REGION=ir-thr-at1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
