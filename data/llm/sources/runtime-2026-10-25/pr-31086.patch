index cc0772913bec..e580846141b3 100644
--- a/gguf-py/gguf/quants.py
+++ b/gguf-py/gguf/quants.py
@@ -758,6 +758,66 @@ def dequantize_blocks(cls, blocks: np.ndarray) -> np.ndarray:
