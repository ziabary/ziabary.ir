PUBLIC_URL=https://api.ziabary.ir
SITE_ORIGINS=https://ziabary.ir,https://www.ziabary.ir
# Public website to verify pages against; defaults to the first SITE_ORIGINS entry.
SITE_URL=https://ziabary.ir
COMMUNITY_PORT=8787
# Trust only the exact address/CIDR of the TLS reverse proxy as seen by the container.
# Never trust all addresses. The reverse proxy must replace incoming X-Forwarded-For.
TRUSTED_PROXY_CIDRS=
COMMENTS_PER_SECOND=5
VISIT_RETENTION_DAYS=90
# Daily summaries remain available after detailed IP/browser records expire.
ANALYTICS_RETENTION_DAYS=1095
MAX_DATABASE_MIB=512
ADMIN_DISPLAY_NAME=مهران ضیابری
